#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/core/bin/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/core/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules:/root/app/code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/core/bin/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/core/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules/@agent-native/node_modules:/root/app/code/node_modules/.pnpm/@agent-native+core@0.182.1_66e6248338d49745bc05dddd924afb37/node_modules:/root/app/code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@agent-native/core/bin/agent-native.js" "$@"
else
  exec node  "$basedir/../@agent-native/core/bin/agent-native.js" "$@"
fi
