#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/root/app/code/node_modules/.pnpm/vitest@4.1.10_@opentelemetry+api@1.9.1_@types+node@24.13.3_vite@8.1.0_@types+node@24.13_2e470f95e90bd7c48a88f5cbfc11261a/node_modules/vitest/node_modules:/root/app/code/node_modules/.pnpm/vitest@4.1.10_@opentelemetry+api@1.9.1_@types+node@24.13.3_vite@8.1.0_@types+node@24.13_2e470f95e90bd7c48a88f5cbfc11261a/node_modules:/root/app/code/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/root/app/code/node_modules/.pnpm/vitest@4.1.10_@opentelemetry+api@1.9.1_@types+node@24.13.3_vite@8.1.0_@types+node@24.13_2e470f95e90bd7c48a88f5cbfc11261a/node_modules/vitest/node_modules:/root/app/code/node_modules/.pnpm/vitest@4.1.10_@opentelemetry+api@1.9.1_@types+node@24.13.3_vite@8.1.0_@types+node@24.13_2e470f95e90bd7c48a88f5cbfc11261a/node_modules:/root/app/code/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
fi
